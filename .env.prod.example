# =============================================================================
# 生产环境 — 分两类：
#
# 1) 构建期（npm run build:prod / SRE 第三条 RUN 在 /opt/prod 下构建）
# =============================================================================
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# =============================================================================
# 2) 运行期（生产容器/进程连生产库、生产 Redis）
#    在生产 Deployment / SRE 生产应用里单独配置，与预发实例的配置互不相干，例如：
#
# DATABASE_URL="mysql://user:pass@生产-mysql地址:3306/库名?charset=utf8mb3"
# REDIS_HOST=生产-redis
# REDIS_PORT=6379
# MINIO_ENDPOINT=...
# HUB_ADMIN_SECRET=...
#
# 完整变量说明见根目录 .env.example。
# =============================================================================
