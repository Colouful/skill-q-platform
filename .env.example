# 本地默认：复制为 .env 后改成本机值（next dev / 单环境 build）
#
# 预发 / 生产双包：
#   cp deploy/env.pre.template .env.pre
#   cp deploy/env.prod.template .env.prod
# 再编辑填密钥。.env.pre / .env.prod 被 Git 忽略，不会提交。

# 数据库（二选一）
# A) 整条连接串
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/xiaqiu?charset=utf8mb3"
# B) 分变量（与 .env.pre / .env.prod 一致，password 可含特殊字符）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=user
# DB_PASSWORD=pass
# DB_DATABASE=xiaqiu

# Redis（单机）
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# MinIO
# MINIO_ENDPOINT=
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
