# 本地默认：复制为 .env 后改成本机值（next dev / 单环境 build）
#
# 预发 / 生产双包：
#   cp deploy/env.pre.template .env.pre
#   cp deploy/env.prod.template .env.prod
# 再编辑填密钥。.env.pre / .env.prod 被 Git 忽略，不会提交。

# 数据库：推荐整条 DATABASE_URL（与 .env / .env.pre / .env.prod 一致）
# 密码含 @ # ? 等时须 URL 编码：node -e "console.log(encodeURIComponent('密码'))"
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/xiaqiu?charset=utf8mb3"
# 未设 DATABASE_URL 时，可用 DB_HOST、DB_PORT、DB_USER、DB_PASSWORD、DB_DATABASE 由 build-env.sh 自动拼接（见 scripts/compose-database-url.cjs）

# Redis（单机）
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# MinIO
# MINIO_ENDPOINT=
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
