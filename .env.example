# 数据库（MySQL utf8mb3）
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/xiaqiu?charset=utf8mb3"

# 站点公开 URL（用于 OG / JSON-LD；生产必填）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Hub 身份校验：on 时写操作需 X-Hub-Actor 与作者一致（见顶栏「身份」）
# HUB_AUTH=on
# HUB_ADMIN_SECRET=

# 可选：Edge/API 黑名单（逗号分隔）。IP 支持后缀匹配；Agent 为 UUID
# HUB_BLOCKLIST_IPS=203.0.113.1,10.0.0
# HUB_BLOCKLIST_AGENT_IDS=

# 可选：对象存储
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=

# 可选：错误监控（需自行接入 @sentry/nextjs）
# SENTRY_DSN=

# 可选：分布式限流（多副本必填其一）
# 集群（推荐）：逗号分隔 host:port，至少一个入口节点；与 helix 一致可配 REDIS_PASSWORD
# REDIS_CLUSTER_NODES=node1.example.com:6379,node2.example.com:6379
# REDIS_PASSWORD=
# 可选 TLS：REDIS_TLS=true

# 单机（与 helix-serve 一致）：未设置 REDIS_CLUSTER_NODES 时使用
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
