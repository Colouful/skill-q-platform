// 虾球Hub — MySQL utf8mb3（连接串 charset=utf8mb3）
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Agent {
  id             String    @id @default(uuid()) @db.VarChar(191)
  name           String    @db.VarChar(100)
  slug           String    @unique @db.VarChar(100)
  avatar         String?   @db.VarChar(500)
  agentType      String    @default("unknown") @db.VarChar(50)
  level          Int       @default(1)
  levelName      String    @default("见习特工") @db.VarChar(20)
  experience     Int       @default(0)
  apiCallsTotal  Int       @default(0)
  uploadsCount   Int       @default(0)
  downloadsCount Int       @default(0)
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastActiveAt   DateTime?
  registeredAt   DateTime  @default(now())
  metadata       Json?

  apiKeys          ApiKey[]
  sessions         AgentSession[]
  uploadedSkills   Skill[]           @relation("SkillAuthor")
  uploadedRules    Rule[]            @relation("RuleAuthor")
  uploadedRoles    RoleTemplate[]    @relation("RoleAuthor")
  authoredReviews  Review[]          @relation("ReviewAuthor")
  downloadLogs     DownloadLog[]
  hubNotifications HubNotification[]

  @@index([slug])
  @@index([agentType])
  @@index([level])
  @@map("agents")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.VarChar(191)
  keyHash     String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix   String    @db.VarChar(24)
  agentId     String    @db.VarChar(191)
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name        String    @default("Default") @db.VarChar(50)
  description String?   @db.Text
  scopes      Json      @default("[]")
  rateLimit   Int       @default(100)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isRevoked   Boolean   @default(false)

  sessions AgentSession[]

  @@index([agentId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model AgentSession {
  id        String   @id @default(uuid()) @db.VarChar(191)
  sessionId String   @unique @db.VarChar(64)
  agentId   String   @db.VarChar(191)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  apiKeyId  String   @db.VarChar(191)
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userAgent String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(50)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([agentId])
  @@map("agent_sessions")
}

model Category {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(50)
  slug         String   @db.VarChar(50)
  description  String?  @db.Text
  icon         String?  @db.VarChar(255)
  resourceType String   @default("skill") @db.VarChar(20)
  sortOrder    Int      @default(0)
  skills       Skill[]
  rules        Rule[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([slug, resourceType])
  @@unique([name, resourceType])
  @@map("categories")
}

model Skill {
  id                String                 @id @default(uuid())
  name              String                 @db.VarChar(255)
  slug              String                 @unique @db.VarChar(255)
  registryId        String?                @db.VarChar(255)
  manifestId        String?                @db.VarChar(255)
  description       String                 @db.Text
  longDescription   String?                @db.Text
  author            String                 @db.VarChar(100)
  categoryId        String
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  downloads         Int                    @default(0)
  rating            Float                  @default(0)
  reviewCount       Int                    @default(0)
  isFeatured        Boolean                @default(false)
  tags              Json?
  forkedFromSkillId String?                @db.VarChar(36)
  authorAgentId     String?                @db.VarChar(191)
  authorAgent       Agent?                 @relation("SkillAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  downloadPolicy    String                 @default("public") @db.VarChar(20)
  moderationStatus  String                 @default("published") @db.VarChar(20)
  moderationNote    String?                @db.Text
  supportedProfiles Json?
  versions          Version[]
  reviews           Review[]
  roleLinks         RoleSkillLink[]
  scenarioLinks     ScenarioPackageSkill[]
  domainLinks       SkillDomainLink[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([registryId])
  @@index([manifestId])
  @@index([downloads])
  @@index([rating])
  @@index([moderationStatus])
  @@map("skills")
}

model Rule {
  id                String                @id @default(uuid())
  name              String                @db.VarChar(255)
  slug              String                @unique @db.VarChar(255)
  registryId        String?               @db.VarChar(255)
  manifestId        String?               @db.VarChar(255)
  description       String                @db.Text
  longDescription   String?               @db.Text
  author            String                @db.VarChar(100)
  categoryId        String
  category          Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  downloads         Int                   @default(0)
  rating            Float                 @default(0)
  reviewCount       Int                   @default(0)
  isFeatured        Boolean               @default(false)
  tags              Json?
  forkedFromRuleId  String?               @db.VarChar(36)
  authorAgentId     String?               @db.VarChar(191)
  authorAgent       Agent?                @relation("RuleAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  downloadPolicy    String                @default("public") @db.VarChar(20)
  moderationStatus  String                @default("published") @db.VarChar(20)
  moderationNote    String?               @db.Text
  supportedProfiles Json?
  versions          RuleVersion[]
  reviews           Review[]
  roleLinks         RoleRuleLink[]
  scenarioLinks     ScenarioPackageRule[]
  domainLinks       RuleDomainLink[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([registryId])
  @@index([manifestId])
  @@index([author])
  @@index([downloads])
  @@index([rating])
  @@index([moderationStatus])
  @@map("rules")
}

model Version {
  id          String   @id @default(uuid())
  version     String   @db.VarChar(20)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  changelog   String?  @db.Text
  files       Json
  downloadUrl String?  @db.VarChar(500)
  isLatest    Boolean  @default(false)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([skillId, version])
  @@index([skillId])
  @@map("versions")
}

model RuleVersion {
  id          String   @id @default(uuid())
  version     String   @db.VarChar(20)
  ruleId      String
  rule        Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  changelog   String?  @db.Text
  files       Json
  downloadUrl String?  @db.VarChar(500)
  isLatest    Boolean  @default(false)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([ruleId, version])
  @@index([ruleId])
  @@map("rule_versions")
}

model Review {
  id            String   @id @default(uuid())
  resourceType  String   @default("skill") @db.VarChar(20)
  resourceId    String   @db.VarChar(36)
  skillId       String?
  skill         Skill?   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  ruleId        String?
  rule          Rule?    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  rating        Int
  content       String   @db.Text
  author        String   @db.VarChar(100)
  authorAgentId String?  @db.VarChar(191)
  authorAgent   Agent?   @relation("ReviewAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  isHelpful     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([skillId])
  @@index([ruleId])
  @@index([resourceType, resourceId])
  @@map("reviews")
}

model DownloadLog {
  id           String   @id @default(uuid())
  agentId      String?  @db.VarChar(191)
  agent        Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  resourceType String   @db.VarChar(20)
  resourceId   String   @db.VarChar(36)
  ipAddress    String   @db.VarChar(50)
  userAgent    String?  @db.VarChar(500)
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([resourceType, resourceId])
  @@map("download_logs")
}

model CategoryAuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  adminId    String   @db.VarChar(36)
  action     String   @db.VarChar(40)
  categoryId String?  @db.VarChar(36)
  details    Json
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([categoryId])
  @@map("category_audit_logs")
}

model SystemConfig {
  configKey   String   @id @map("config_key") @db.VarChar(64)
  configValue String   @map("config_value") @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model HubNotification {
  id        String    @id @default(uuid()) @db.VarChar(36)
  agentId   String    @map("agent_id") @db.VarChar(191)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(255)
  content   String    @db.Text
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([agentId])
  @@index([agentId, isRead])
  @@map("hub_notifications")
}

model Admin {
  id           String         @id @default(uuid()) @db.VarChar(36)
  email        String         @unique @db.VarChar(255)
  passwordHash String         @db.VarChar(255)
  role         String         @default("moderator") @db.VarChar(32)
  permissions  Json           @default("[]")
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]

  @@map("admins")
}

model AdminSession {
  id        String   @id @default(uuid()) @db.VarChar(36)
  sessionId String   @unique @db.VarChar(64)
  adminId   String   @db.VarChar(36)
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([adminId])
  @@map("admin_sessions")
}

model RoleTemplate {
  id                String                @id @default(uuid()) @db.VarChar(36)
  name              String                @db.VarChar(255)
  slug              String                @unique @db.VarChar(120)
  registryId        String?               @db.VarChar(255)
  manifestId        String?               @db.VarChar(255)
  description       String                @db.Text
  longDescription   String?               @db.Text
  author            String                @db.VarChar(100)
  authorAgentId     String?               @db.VarChar(191)
  authorAgent       Agent?                @relation("RoleAuthor", fields: [authorAgentId], references: [id], onDelete: SetNull)
  publishStatus     String                @default("draft") @db.VarChar(20)
  roleStatus        String                @default("draft") @db.VarChar(20)
  tags              Json?
  supportedProfiles Json?
  triggers          Json?
  preferredSkills   Json?
  reads             Json?
  writes            Json?
  handoffTo         Json?
  rolePositioning   String?               @db.Text
  workingPrinciples Json?
  requiredSteps     Json?
  executionContract String?               @db.Text
  outputStandard    String?               @db.Text
  prohibitedActions Json?
  handoffNotes      String?               @db.Text
  versions          RoleVersion[]
  skillLinks        RoleSkillLink[]
  ruleLinks         RoleRuleLink[]
  scenarioLinks     ScenarioPackageRole[]
  entryForScenarios ScenarioPackage[]     @relation("ScenarioEntryRole")
  domainLinks       RoleDomainLink[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([slug])
  @@index([registryId])
  @@index([manifestId])
  @@index([publishStatus])
  @@index([authorAgentId])
  @@map("role_templates")
}

model RoleVersion {
  id          String       @id @default(uuid()) @db.VarChar(36)
  roleId      String       @db.VarChar(36)
  role        RoleTemplate @relation(fields: [roleId], references: [id], onDelete: Cascade)
  version     String       @db.VarChar(20)
  changelog   String?      @db.Text
  files       Json
  downloadUrl String?      @db.VarChar(500)
  isLatest    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@unique([roleId, version])
  @@index([roleId])
  @@map("role_versions")
}

model RoleSkillLink {
  id        String       @id @default(uuid()) @db.VarChar(36)
  roleId    String       @db.VarChar(36)
  role      RoleTemplate @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skillId   String       @db.VarChar(36)
  skill     Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)

  @@unique([roleId, skillId])
  @@index([roleId])
  @@index([skillId])
  @@map("role_skill_links")
}

model RoleRuleLink {
  id        String       @id @default(uuid()) @db.VarChar(36)
  roleId    String       @db.VarChar(36)
  role      RoleTemplate @relation(fields: [roleId], references: [id], onDelete: Cascade)
  ruleId    String       @db.VarChar(36)
  rule      Rule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)

  @@unique([roleId, ruleId])
  @@index([roleId])
  @@index([ruleId])
  @@map("role_rule_links")
}

model ScenarioPackage {
  id                String                 @id @default(uuid()) @db.VarChar(36)
  name              String                 @db.VarChar(255)
  slug              String                 @unique @db.VarChar(120)
  description       String                 @db.Text
  longDescription   String?                @db.Text
  publishStatus     String                 @default("draft") @db.VarChar(20)
  supportedProfiles Json?
  recommendedIdes   Json?
  entryRoleId       String?                @db.VarChar(36)
  entryRole         RoleTemplate?          @relation("ScenarioEntryRole", fields: [entryRoleId], references: [id], onDelete: SetNull)
  tags              Json?
  isFeatured        Boolean                @default(false)
  roles             ScenarioPackageRole[]
  skills            ScenarioPackageSkill[]
  rules             ScenarioPackageRule[]
  domainLinks       ScenarioDomainLink[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([slug])
  @@index([publishStatus])
  @@index([entryRoleId])
  @@map("scenario_packages")
}

model ScenarioPackageRole {
  id                String          @id @default(uuid()) @db.VarChar(36)
  scenarioPackageId String          @db.VarChar(36)
  scenarioPackage   ScenarioPackage @relation(fields: [scenarioPackageId], references: [id], onDelete: Cascade)
  roleId            String          @db.VarChar(36)
  role              RoleTemplate    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sortOrder         Int             @default(0)
  isOptional        Boolean         @default(false)

  @@unique([scenarioPackageId, roleId])
  @@index([scenarioPackageId])
  @@index([roleId])
  @@map("scenario_package_roles")
}

model ScenarioPackageSkill {
  id                String          @id @default(uuid()) @db.VarChar(36)
  scenarioPackageId String          @db.VarChar(36)
  scenarioPackage   ScenarioPackage @relation(fields: [scenarioPackageId], references: [id], onDelete: Cascade)
  skillId           String          @db.VarChar(36)
  skill             Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sortOrder         Int             @default(0)

  @@unique([scenarioPackageId, skillId])
  @@index([scenarioPackageId])
  @@index([skillId])
  @@map("scenario_package_skills")
}

model ScenarioPackageRule {
  id                String          @id @default(uuid()) @db.VarChar(36)
  scenarioPackageId String          @db.VarChar(36)
  scenarioPackage   ScenarioPackage @relation(fields: [scenarioPackageId], references: [id], onDelete: Cascade)
  ruleId            String          @db.VarChar(36)
  rule              Rule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sortOrder         Int             @default(0)

  @@unique([scenarioPackageId, ruleId])
  @@index([scenarioPackageId])
  @@index([ruleId])
  @@map("scenario_package_rules")
}

model CapabilityDomain {
  id            String               @id @default(uuid()) @db.VarChar(36)
  name          String               @unique @db.VarChar(100)
  slug          String               @unique @db.VarChar(100)
  description   String?              @db.Text
  sortOrder     Int                  @default(0)
  roleLinks     RoleDomainLink[]
  skillLinks    SkillDomainLink[]
  ruleLinks     RuleDomainLink[]
  scenarioLinks ScenarioDomainLink[]

  @@index([sortOrder])
  @@map("capability_domains")
}

model RoleDomainLink {
  id       String           @id @default(uuid()) @db.VarChar(36)
  roleId   String           @db.VarChar(36)
  role     RoleTemplate     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  domainId String           @db.VarChar(36)
  domain   CapabilityDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([roleId, domainId])
  @@index([roleId])
  @@index([domainId])
  @@map("role_domain_links")
}

model SkillDomainLink {
  id       String           @id @default(uuid()) @db.VarChar(36)
  skillId  String           @db.VarChar(36)
  skill    Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  domainId String           @db.VarChar(36)
  domain   CapabilityDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([skillId, domainId])
  @@index([skillId])
  @@index([domainId])
  @@map("skill_domain_links")
}

model RuleDomainLink {
  id       String           @id @default(uuid()) @db.VarChar(36)
  ruleId   String           @db.VarChar(36)
  rule     Rule             @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  domainId String           @db.VarChar(36)
  domain   CapabilityDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([ruleId, domainId])
  @@index([ruleId])
  @@index([domainId])
  @@map("rule_domain_links")
}

model HubAsset {
  id              String             @id @default(uuid()) @db.VarChar(36)
  slug            String             @db.VarChar(191)
  name            String             @db.VarChar(255)
  kind            String             @db.VarChar(40)
  scope           String             @default("platform") @db.VarChar(40)
  ownerOrgId      String?            @db.VarChar(191)
  ownerTeamId     String?            @db.VarChar(191)
  ownerUserId     String?            @db.VarChar(191)
  status          String             @default("draft") @db.VarChar(40)
  description     String?            @db.Text
  tags            Json?
  visibility      String?            @db.VarChar(40)
  latestVersionId String?            @db.VarChar(36)
  deprecatedAt    DateTime?
  archivedAt      DateTime?
  createdBy       String?            @db.VarChar(191)
  updatedBy       String?            @db.VarChar(191)
  versions        HubAssetVersion[]
  manifestLinks   HubManifestAsset[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([slug, scope, ownerOrgId])
  @@index([slug])
  @@index([kind])
  @@index([status])
  @@map("hub_asset")
}

model HubAssetVersion {
  id                String             @id @default(uuid()) @db.VarChar(36)
  assetId           String             @db.VarChar(36)
  asset             HubAsset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version           String             @db.VarChar(40)
  content           String             @db.LongText
  contentFormat     String             @default("markdown") @db.VarChar(40)
  checksum          String             @db.VarChar(128)
  status            String             @default("draft") @db.VarChar(40)
  immutable         Boolean            @default(false)
  qualityScore      Int                @default(0)
  dependencies      Json?
  compatibility     Json?
  changelog         String?            @db.Text
  createdBy         String?            @db.VarChar(191)
  publishedBy       String?            @db.VarChar(191)
  rejectedAt        DateTime?
  rejectedReason    String?            @db.Text
  source            String?            @db.VarChar(80)
  contentSize       Int?
  previousVersionId String?            @db.VarChar(36)
  manifestLinks     HubManifestAsset[]
  createdAt         DateTime           @default(now())
  publishedAt       DateTime?

  @@unique([assetId, version])
  @@index([checksum])
  @@index([status])
  @@map("hub_asset_version")
}

model HubManifest {
  id              String               @id @default(uuid()) @db.VarChar(36)
  slug            String               @db.VarChar(191)
  name            String               @db.VarChar(255)
  scope           String               @default("platform") @db.VarChar(40)
  ownerOrgId      String?              @db.VarChar(191)
  ownerTeamId     String?              @db.VarChar(191)
  status          String               @default("draft") @db.VarChar(40)
  description     String?              @db.Text
  tags            Json?
  techStacks      Json?
  projectKinds    Json?
  recommendedFor  Json?
  latestVersionId String?              @db.VarChar(36)
  deprecatedAt    DateTime?
  archivedAt      DateTime?
  createdBy       String?              @db.VarChar(191)
  updatedBy       String?              @db.VarChar(191)
  versions        HubManifestVersion[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([slug, scope, ownerOrgId])
  @@index([slug])
  @@index([status])
  @@map("hub_manifest")
}

model HubManifestVersion {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  manifestId          String             @db.VarChar(36)
  manifest            HubManifest        @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  version             String             @db.VarChar(40)
  status              String             @default("draft") @db.VarChar(40)
  checksum            String             @db.VarChar(128)
  installPolicy       Json
  compatibility       Json?
  changelog           String?            @db.Text
  createdBy           String?            @db.VarChar(191)
  publishedBy         String?            @db.VarChar(191)
  rejectedAt          DateTime?
  rejectedReason      String?            @db.Text
  previousVersionId   String?            @db.VarChar(36)
  exportSchemaVersion String?            @db.VarChar(40)
  assets              HubManifestAsset[]
  createdAt           DateTime           @default(now())
  publishedAt         DateTime?

  @@unique([manifestId, version])
  @@index([checksum])
  @@index([status])
  @@map("hub_manifest_version")
}

model HubManifestAsset {
  id                String             @id @default(uuid()) @db.VarChar(36)
  manifestVersionId String             @db.VarChar(36)
  manifestVersion   HubManifestVersion @relation(fields: [manifestVersionId], references: [id], onDelete: Cascade)
  assetId           String             @db.VarChar(36)
  asset             HubAsset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetVersionId    String             @db.VarChar(36)
  assetVersion      HubAssetVersion    @relation(fields: [assetVersionId], references: [id], onDelete: Restrict)
  kind              String             @db.VarChar(40)
  required          Boolean            @default(true)
  loadWhen          Json?
  order             Int                @default(0)
  alias             String?            @db.VarChar(191)
  reason            String?            @db.Text
  stage             String?            @db.VarChar(80)
  addedBy           String?            @db.VarChar(191)
  addedAt           DateTime?
  policy            Json?

  @@index([manifestVersionId])
  @@index([assetId])
  @@index([assetVersionId])
  @@map("hub_manifest_asset")
}

model HubAgentProfile {
  id           String    @id @default(uuid()) @db.VarChar(36)
  slug         String    @db.VarChar(191)
  name         String    @db.VarChar(255)
  scope        String    @default("platform") @db.VarChar(40)
  status       String    @default("draft") @db.VarChar(40)
  version      String    @default("1.0.0") @db.VarChar(40)
  content      Json
  checksum     String    @db.VarChar(128)
  ownerOrgId   String?   @db.VarChar(191)
  ownerTeamId  String?   @db.VarChar(191)
  ownerUserId  String?   @db.VarChar(191)
  riskLevel    String?   @db.VarChar(40)
  createdBy    String?   @db.VarChar(191)
  publishedBy  String?   @db.VarChar(191)
  deprecatedAt DateTime?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?

  @@unique([slug, version, scope])
  @@index([slug])
  @@index([status])
  @@map("hub_agent_profile")
}

